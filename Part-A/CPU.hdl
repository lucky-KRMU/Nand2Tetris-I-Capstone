// File name: CPU.hdl

/**
 * The Hack CPU (Central Processing unit), consisting of an ALU,
 * two registers named A and D, and a program counter named PC.
 * The CPU is designed to fetch and execute instructions written in 
 * the Hack machine language. In the case of a C-instruction, the 
 * combines with the destination fields to determine where to store
 * the result, and with the jump fields to determine what instruction
 * to fetch next. In the case of an A-instruction, the instruction
 * contents is loaded into the A register.
 */

CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // Instruction decoding:
    // A-instruction: instruction[15] == 0
    // C-instruction: instruction[15] == 1
    //   instruction[12]: a-bit (0 = A, 1 = M)
    //   instruction[11..6]: c1..c6 (zx, nx, zy, ny, f, no)
    //   instruction[5..3]: d1, d2, d3 (A, D, M)
    //   instruction[2..0]: j1, j2, j3 (<0, =0, >0)

    // A register logic:
    // In A: either instruction (if A-instruction) or outALU (if C-instruction)
    Mux16(a=instruction, b=outALU, sel=instruction[15], out=inA);

    // Load A if A-instruction (instruction[15] == 0) OR (C-instruction AND instruction[5] == 1)
    Not(in=instruction[15], out=isA);
    And(a=instruction[15], b=instruction[5], out=isCAndDestA);
    Or(a=isA, b=isCAndDestA, out=loadA);
    ARegister(in=inA, load=loadA, out=outA, out[0..14]=addressM);

    // D register logic:
    // Load D if C-instruction AND instruction[4] == 1
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=outALU, load=loadD, out=outD);

    // ALU input selection: A register vs inM based on instruction[12] (a-bit)
    Mux16(a=outA, b=inM, sel=instruction[12], out=inAM);

    // ALU execution:
    ALU(x=outD, y=inAM,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=outALU,
        out=outM,
        zr=zr,
        ng=ng);

    // writeM logic: C-instruction AND instruction[3] == 1
    And(a=instruction[15], b=instruction[3], out=writeM);

    // PC jump logic:
    // zr: out == 0
    // ng: out < 0
    // strictly positive (> 0): Not(zr or ng)
    Or(a=zr, b=ng, out=lteZero);
    Not(in=lteZero, out=gtZero);

    // Jump conditions:
    And(a=instruction[2], b=ng, out=jlt);      // j1: out < 0
    And(a=instruction[1], b=zr, out=jeq);      // j2: out == 0
    And(a=instruction[0], b=gtZero, out=jgt);  // j3: out > 0

    Or(a=jlt, b=jeq, out=jle);
    Or(a=jle, b=jgt, out=jumpCond);

    // Only jump if it's a C-instruction
    And(a=instruction[15], b=jumpCond, out=pcLoad);

    // PC: load address from A if jump, otherwise inc=true, reset if reset
    PC(in=outA, load=pcLoad, inc=true, reset=reset, out[0..14]=pc);
}
